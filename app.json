{
  "expo": {
    "name": "FestGo",
    "slug": "festgo",
    "version": "1.3.0",
    "scheme": "festgo",
    "linking": {
      "prefixes": [
        "festgo://",
        "https://www.festgo.in"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.festgo.app",
      "buildNumber": "4",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to find nearby hotels and provide location-based services.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to location to find nearby hotels and provide location-based services even when the app is in the background.",
        "NSCameraUsageDescription": "This app needs access to camera to take profile pictures and upload images.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select profile pictures and upload images.",
        "NSMicrophoneUsageDescription": "This app needs access to microphone for voice features.",
        "NSFaceIDUsageDescription": "This app uses Face ID for secure authentication.",
        "UIBackgroundModes": [
          "fetch"
        ],
        "CFBundleDisplayName": "FestGo",
        "CFBundleName": "FestGo",
        "CFBundleShortVersionString": "1.3.0",
        "CFBundleVersion": "4",
        "LSApplicationQueriesSchemes": [
          "tel",
          "mailto",
          "https"
        ],
        "UIRequiresFullScreen": false,
        "UIStatusBarStyle": "light-content",
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
  "applinks:festgo.in",
  "applinks:www.festgo.in"
]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.festgo.app",
      "versionCode": 4,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.festgo.app"
    },
    "owner": "festgo-app",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b738104d-9d56-449f-8afa-d2e3fa22f365"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b738104d-9d56-449f-8afa-d2e3fa22f365"
      }
    }
  }
}
